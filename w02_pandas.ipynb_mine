    {
      "cell_type": "code",
      "source": [
        "# convert data types from str to float\n",
        "month_cols = fishing_data.columns.drop(\"flag\")\n",
        "\n",
        "fishing_data[month_cols] = (\n",
        "    fishing_data[month_cols]\n",
        "    .replace(\",\", \"\", regex=True)\n",
        "    .astype(float)\n",
        ")\n",
        "\n",
        "fishing_data.dtypes.value_counts()   # shows float64 (plus one object for 'flag')"
      ],
