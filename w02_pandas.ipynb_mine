    {
      "cell_type": "code",
      "source": [
        "# total hours per flag per year\n",
        "\n",
        "annual_hours = fish_long.groupby([\"flag\", fish_long[\"month\"].dt.year])[\"fishing_hours\"].sum().unstack()\n",
        "annual_hours"
      ],
