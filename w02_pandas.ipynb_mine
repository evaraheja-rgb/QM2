    {
      "cell_type": "code",
      "source": [
        "income.loc[[1,50, 99], \"Childless couple, annual income\"]\n",
        "\n",
        "# Coupling increases the value of annual income for all 3 of the percentiles\n",
        "# This relationship appears to be exponential (higher returns for higher percentiles)\n"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/",
          "height": 209
        },
        "id": "BhSAz5_onR7m",
