              "summary": "{\n  \"name\": \"clean\",\n  \"rows\": 99,\n  \"fields\": [\n    {\n      \"column\": \"Percentile Point\",\n      \"properties\": {\n        \"dtype\": \"number\",\n        \"std\": 28,\n        \"min\": 1,\n        \"max\": 99,\n        \"num_unique_values\": 99,\n        \"samples\": [\n          63,\n          41,\n          96\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    },\n    {\n      \"column\": \"Childless couple, annual income\",\n      \"properties\": {\n        \"dtype\": \"number\",\n        \"std\": 15965.475233365678,\n        \"min\": 1746.92,\n        \"max\": 108990.74,\n        \"num_unique_values\": 99,\n        \"samples\": [\n          26058.46,\n          19349.72,\n          61237.18\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    },\n    {\n      \"column\": \"Single adult\",\n      \"properties\": {\n        \"dtype\": \"number\",\n        \"std\": 10696.868419300397,\n        \"min\": 1170.44,\n        \"max\": 73023.8,\n        \"num_unique_values\": 99,\n        \"samples\": [\n          17459.17,\n          12964.31,\n          41028.91\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    }\n  ]\n}"
            }
          },
          "metadata": {},
          "execution_count": 60
        }
      ],
      "source": [
        "clean = income[[\"Childless couple, annual income\", \"Single adult\"]]\n",
        "clean = clean.replace(\",\", \"\", regex=True).astype(float)\n",
        "clean.head()"
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "# renamed 'the fiscal benefits of coupling'\n",
        "clean.plot()\n",
        "plt.title(\"A Modest Proposal: the fiscal benefits of coupling\")\n",
        "plt.xlabel(\"Percentile\")\n",
        "plt.ylabel(\"Income per year (GBP)\")\n",
        "plt.show()\n",
        "\n",
        "# Once again, coupling increases the value of annual income\n",
        "# there is a more significant difference at the higher percentiles between a childless couple and single adult than a couple with children"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/",
          "height": 487
        },
        "id": "GF04Jhog0tSu",
        "outputId": "c0578c70-212d-4a8e-94dd-b2a48b1559a9"
      },
      "id": "GF04Jhog0tSu",
      "execution_count": 61,
