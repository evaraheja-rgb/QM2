    {
      "cell_type": "code",
      "source": [
        "# melt the wide data to long format\n",
        "\n",
        "fish_long = fishing_data.melt(id_vars=\"flag\", var_name=\"month\", value_name=\"fishing_hours\")\n",
        "fish_long[\"month\"] = pd.to_datetime(fish_long[\"month\"])\n",
        "print(fishing_data.shape, \"->\", fish.shape)\n",
        "fish_long.head()\n",
        "\n",
        "\n"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/",
          "height": 223
