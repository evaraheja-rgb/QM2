      "source": [
        "fish = fish_wide.melt(id_vars=\"flag\", var_name=\"month\", value_name=\"fishing_hours\")\n",
        "fish[\"month\"] = pd.to_datetime(fish[\"month\"])\n",
        "print(fish_wide.shape, \"->\", fish.shape)\n",
        "fish.head()"
      ]
    },
