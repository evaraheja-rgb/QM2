      "execution_count": 51,
      "outputs": [
        {
          "output_type": "execute_result",
          "data": {
            "text/plain": [
              "Percentile Point\n",
              "1       1,746.92\n",
              "50     21,832.75\n",
              "99    108,990.74\n",
              "Name: Childless couple, annual income, dtype: object"
            ],
            "text/html": [
              "<div>\n",
              "<style scoped>\n",
